# =============================================================================
# HotelAI environment configuration
# Copy to .env.local (never committed) and fill in values:
#   cp .env.example .env.local
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else
# is server-only and must never be referenced from Client Components.
# =============================================================================

# --- Application -------------------------------------------------------------
# Canonical public URL. Used to build links in emails and auth redirects
# (never derived from request headers). Must match Supabase Auth "Site URL".
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 1) ------------------------------------------------------
# Project Settings -> API Keys. The publishable key (sb_publishable_...) is
# safe for the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER ONLY. Bypasses Row Level Security.
# Used for verified webhooks and background jobs (from Phase 2+).
SUPABASE_SECRET_KEY=

# --- OpenAI (Phase 5) --------------------------------------------------------
# Server only. Required for the agent playground (with SUPABASE_SECRET_KEY).
OPENAI_API_KEY=
# Model id your OpenAI account can use with the Responses API (check the
# OpenAI dashboard). There is deliberately no default.
OPENAI_MODEL=
# Optional. Set to "false" only if your model rejects
# include=["reasoning.encrypted_content"].
# OPENAI_INCLUDE_REASONING=true
# Optional. Maximum tokens per model response (default 1500).
# OPENAI_MAX_OUTPUT_TOKENS=1500

# --- Resend transactional email (Phase 3+: team invitations) -----------------
# Optional. Without these, invitations still work: the inviter gets a link to
# share manually. The from address must be on a domain verified in Resend,
# e.g. "HotelAI <no-reply@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Billing (Phase 7) -------------------------------------------------------
BILLING_PROVIDER=paddle
# sandbox | production
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token for Paddle.js checkout (safe for the browser).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

PADDLE_PRICE_BASIC_MONTHLY=
PADDLE_PRICE_BASIC_YEARLY=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=

# --- Local database tests (optional) -----------------------------------------
# npm run test:db creates a throwaway PostgreSQL cluster automatically.
# Set this only to test against an existing EMPTY, disposable database.
# DATABASE_URL_TEST=
